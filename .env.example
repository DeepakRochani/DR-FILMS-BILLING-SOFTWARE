# Public configuration for DR FILMS Billing Suite
# Note: Never place private keys or secrets in this file.

# WhatsApp support contact number for license renewals (country code + number, digits only)
VITE_SUPPORT_WHATSAPP=919876543210
VITE_SUPPORT_PHONE=+91 98765 43210
VITE_SUPPORT_EMAIL=contact@drfilms.studio

# Remote revocation endpoint (optional, fetches signed revoked.json)
VITE_REVOCATION_URL=https://billing.drfilms.studio/revoked.json

# License Public Key (JSON Web Key format, optional override)
# VITE_LICENSE_PUBLIC_KEY=
